# Environment Variables Example for SMS-BOT

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Server Port and Public Web URL
PORT=8080
WEB_URL=https://your-domain.onrender.com

# Supabase Database Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# AI Service API Keys (at least one required for AI features)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Cloudflare AI Configuration (Optional)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Telegram Client API (from https://my.telegram.org)
TG_API_ID=39458429
TG_API_HASH=your_telegram_api_hash_here

# Master Email Account Configuration
MASTER_EMAIL=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here

# PayPal Integration Settings
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox

# API Security Keys (comma-separated for web panel access)
API_KEYS=your_secret_api_key_here
